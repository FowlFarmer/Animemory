APP_ORIGIN=http://127.0.0.1:5173
PORT=8787

# Required in production. Generates encrypted HttpOnly OAuth and provider-token cookies.
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# Optional. Enables Gemini parsing. Without it, Animemory falls back to deterministic parsing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# MyAnimeList OAuth app credentials.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://127.0.0.1:8787/api/auth/mal/callback

# AniList OAuth app credentials.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://127.0.0.1:8787/api/auth/anilist/callback
