APP_ORIGIN=http://127.0.0.1:5173
PORT=8787

# Required in production. Create an Upstash Redis database through Vercel or Upstash.
# Local development falls back to a temporary in-memory session store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# Optional. Enables Gemini parsing. Without it, Animemory falls back to deterministic parsing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# MyAnimeList OAuth app credentials.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://127.0.0.1:8787/auth/mal/callback

# AniList OAuth app credentials.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://127.0.0.1:8787/auth/anilist/callback
