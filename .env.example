APP_ORIGIN=http://127.0.0.1:5173
PORT=8787

# Optional Gemini parsing. Disabled by default while testing the fallback parser.
# Set GEMINI_DISABLED=false and provide GEMINI_API_KEY to enable.
GEMINI_DISABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# MyAnimeList OAuth app credentials.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://127.0.0.1:8787/api/auth/mal/callback

# AniList OAuth app credentials.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://127.0.0.1:8787/api/auth/anilist/callback
